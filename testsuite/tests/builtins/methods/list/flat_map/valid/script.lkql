selector countdown_from
| 0 => ()
| n => rec(n-1, n)

val l = [1, 2, 3]

print(l.flat_map(countdown_from)[1])
print(l.flat_map(countdown_from)[2])
print(l.flat_map(countdown_from)[3])
print(l.flat_map(countdown_from).to_list)
print([].flat_map(countdown_from).to_list)

val flat_map_res = l.flat_map((i) => { print("Processing " & i.img); [i, i] })
print(flat_map_res[1])
print(flat_map_res[2])
print(flat_map_res[3])
print(flat_map_res[6])
