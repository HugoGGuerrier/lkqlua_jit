val l = [1, 2, 3, 4, 5, 6]

print(l.filter((i) => i >= 3)[1])
print(l.filter((i) => i >= 3)[2])
print(l.filter((i) => i >= 3)[3])
print(l.filter((i) => i >= 3).to_list)

val filter_res = l.filter((i) => { print("Processing " & i.img); i >= 2 and i < 6 })
print(filter_res[1])
print(filter_res[3])
print(filter_res?[5])
