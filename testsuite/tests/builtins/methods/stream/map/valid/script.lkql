val s_1 = [i for i in [1, 2, 3]]

print(s_1.map((i) => i + 1)[1])
print(s_1.map((i) => i + 1)[2])
print(s_1.map((i) => i + 1)[3])
print(s_1.map((i) => i + 1).to_list)
print([i for i in []].map((i) => i + 1).to_list)

val s_2 = [{ print("Source process " & i.img); i } for i in [1, 2, 3]]
val map_res = s_2.map((i) => { print("Map process " & i.img); i })
print(map_res[1])
print(map_res[3])
